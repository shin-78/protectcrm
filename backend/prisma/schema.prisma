generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  role              String    @default("OPERATOR") // MASTER, SUPERVISOR, OPERATOR
  avatar            String?
  phone             String?
  isActive          Boolean   @default(true)
  lastSeen          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  whatsappSession   WhatsappSession?
  leads             Lead[]           @relation("LeadOperator")
  assignedLeads     Lead[]           @relation("LeadAssigned")
  messages          Message[]
  tasks             Task[]
  notes             Note[]
  notifications     Notification[]
  sentNotifications Notification[]   @relation("NotificationSender")
  activities        Activity[]

  @@map("users")
}

model WhatsappSession {
  id              String        @id @default(uuid())
  userId          String        @unique
  instanceName    String        @unique
  status          String        @default("DISCONNECTED") // CONNECTED, DISCONNECTED, CONNECTING, QR_CODE
  qrCode          String?
  phoneNumber     String?
  profileName     String?
  profilePicture  String?
  webhookUrl      String?
  connectedAt     DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations   Conversation[]

  @@map("whatsapp_sessions")
}

model Lead {
  id              String     @id @default(uuid())
  name            String
  email           String?
  phone           String
  company         String?
  position        String?
  source          String?
  status          String     @default("NEW") // NEW, IN_PROGRESS, PROPOSAL, NEGOTIATION, CLOSED, LOST
  value           Float?
  lostReason      String?
  // tags            String[] // SQLite doesn't support String[], we'll store as JSON string or ignore for MVP
  tagsStr         String?
  avatar          String?
  operatorId      String?
  assignedToId    String?
  pipelineStageId String?
  products        String?
  orderFileUrl    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  operator        User?           @relation("LeadOperator", fields: [operatorId], references: [id])
  assignedTo      User?           @relation("LeadAssigned", fields: [assignedToId], references: [id])
  pipelineStage   PipelineStage?  @relation(fields: [pipelineStageId], references: [id])
  conversations   Conversation[]
  tasks           Task[]
  notes           Note[]
  activities      Activity[]

  @@map("leads")
}

model Pipeline {
  id          String          @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  stages      PipelineStage[]

  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(uuid())
  pipelineId  String
  name        String
  color       String   @default("#6366f1")
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads       Lead[]

  @@map("pipeline_stages")
}

model Conversation {
  id              String    @id @default(uuid())
  sessionId       String
  leadId          String?
  remoteJid       String
  remoteName      String?
  remoteAvatar    String?
  unreadCount     Int       @default(0)
  lastMessageAt   DateTime?
  lastMessageText String?
  isArchived      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  session         WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  lead            Lead?           @relation(fields: [leadId], references: [id])
  messages        Message[]

  @@unique([sessionId, remoteJid])
  @@map("conversations")
}

model Message {
  id              String           @id @default(uuid())
  conversationId  String
  senderId        String?
  messageId       String?
  type            String           @default("TEXT") // TEXT, IMAGE, AUDIO, VIDEO, DOCUMENT, STICKER
  direction       String           // INBOUND, OUTBOUND
  content         String?
  mediaUrl        String?
  mediaType       String?
  mediaMimeType   String?
  fileName        String?
  fileSize        Int?
  duration        Int?
  isRead          Boolean          @default(false)
  isDeleted       Boolean          @default(false)
  quotedMessageId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User?        @relation(fields: [senderId], references: [id])

  @@map("messages")
}

model Task {
  id          String    @id @default(uuid())
  leadId      String?
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  isDone      Boolean   @default(false)
  priority    String    @default("MEDIUM")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead        Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User  @relation(fields: [userId], references: [id])

  @@map("tasks")
}

model Note {
  id        String   @id @default(uuid())
  leadId    String
  userId    String
  content   String
  isInternal Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id])

  @@map("notes")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  senderId   String?
  type       String           // MESSAGE, MENTION, TASK, LEAD, SYSTEM
  title      String
  content    String
  isRead     Boolean          @default(false)
  link       String?
  createdAt  DateTime         @default(now())

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender     User? @relation("NotificationSender", fields: [senderId], references: [id])

  @@map("notifications")
}

model Activity {
  id          String   @id @default(uuid())
  leadId      String?
  userId      String
  action      String
  description String
  metadataStr String?  // SQLite doesn't support Json well, store as JSON string
  createdAt   DateTime @default(now())

  lead        Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User  @relation(fields: [userId], references: [id])

  @@map("activities")
}
